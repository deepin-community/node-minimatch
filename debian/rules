#!/usr/bin/make -f
# -*- makefile -*-

# Uncomment this to turn on verbose mode.
#export DH_VERBOSE=1

%:
	dh $@

override_dh_auto_build:
	tshy
	cp debian/index.cjs .
	node -e 'var f="package.json",p=JSON.parse(require("fs").readFileSync(f));p.main="./index.cjs";p.exports["."].require.default="./index.cjs";p.files.push("index.cjs");require("fs").writeFileSync(f,JSON.stringify(p,null,2)+"\n")'

override_dh_auto_clean:
	dh_auto_clean
	rm -rf .tshy-build dist

override_dh_auto_test:
	node -e "const m = require('.'); const assert = require('assert'); assert(m('foo.js', '*.js')); assert(!m('foo.js', '*.ts')); assert(m('bar/baz/quux.js', '**/*.js')); console.log('ok')"
